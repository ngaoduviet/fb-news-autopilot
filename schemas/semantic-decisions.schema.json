{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fb-news-autopilot:semantic-decisions:1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "news_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "VERIFIED",
              "REVIEW",
              "REJECTED"
            ]
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "enum": [
                "REJECT_OLD_NEWS",
                "REJECT_NO_NEW_DEVELOPMENT",
                "REJECT_NOT_DIRECT_ARTICLE",
                "REJECT_HOMEPAGE_URL",
                "REJECT_CATEGORY_URL",
                "REJECT_SEARCH_URL",
                "REJECT_TAG_TOPIC_URL",
                "REJECT_AGGREGATOR_AS_FINAL_SOURCE",
                "REJECT_REDIRECT_TO_NON_ARTICLE",
                "REJECT_ARTICLE_INACCESSIBLE",
                "REJECT_SOURCE_UNVERIFIABLE",
                "REJECT_HEADLINE_UNSUPPORTED",
                "REJECT_FACTS_UNSUPPORTED",
                "REJECT_DUPLICATE_STORY",
                "REJECT_INVALID_URL",
                "REVIEW_PUBLICATION_TIME_UNCLEAR",
                "REVIEW_EVENT_TIME_UNCLEAR",
                "REVIEW_SOURCE_IDENTITY_UNCLEAR",
                "REVIEW_NEW_DEVELOPMENT_UNCLEAR",
                "REVIEW_CONFLICTING_SOURCES",
                "REVIEW_DUPLICATE_UNCERTAIN",
                "REVIEW_ARTICLE_ACCESS_LIMITED_CORROBORATED",
                "REVIEW_HEADLINE_SUPPORT_UNCLEAR",
                "REVIEW_FACT_SUPPORT_UNCLEAR"
              ]
            }
          },
          "article_title_verified": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "publication_time_verified": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "facts_supported": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "event_time_verified": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "new_development_verified": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "material_development_time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
              },
              {
                "type": "null"
              }
            ]
          },
          "verified_event_key": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "verified_facts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "unsupported_claims": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "claim": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "source_url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://[^/\\s?#]+(?:[/?#].*)?$"
                }
              },
              "required": [
                "claim",
                "quote",
                "source_url"
              ],
              "additionalProperties": false
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "handoff_allowed": {
            "type": "boolean"
          }
        },
        "required": [
          "news_id",
          "status",
          "reason_codes",
          "article_title_verified",
          "publication_time_verified",
          "facts_supported",
          "event_time_verified",
          "new_development_verified",
          "material_development_time",
          "verified_event_key",
          "verified_facts",
          "unsupported_claims",
          "evidence",
          "confidence",
          "handoff_allowed"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "VERIFIED"
                }
              }
            },
            "then": {
              "properties": {
                "reason_codes": {
                  "maxItems": 0
                },
                "article_title_verified": {
                  "const": true
                },
                "publication_time_verified": {
                  "const": true
                },
                "facts_supported": {
                  "const": true
                },
                "unsupported_claims": {
                  "maxItems": 0
                },
                "evidence": {
                  "minItems": 1
                },
                "handoff_allowed": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "REVIEW"
                }
              }
            },
            "then": {
              "properties": {
                "reason_codes": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": [
                      "REVIEW_PUBLICATION_TIME_UNCLEAR",
                      "REVIEW_EVENT_TIME_UNCLEAR",
                      "REVIEW_SOURCE_IDENTITY_UNCLEAR",
                      "REVIEW_NEW_DEVELOPMENT_UNCLEAR",
                      "REVIEW_CONFLICTING_SOURCES",
                      "REVIEW_DUPLICATE_UNCERTAIN",
                      "REVIEW_ARTICLE_ACCESS_LIMITED_CORROBORATED",
                      "REVIEW_HEADLINE_SUPPORT_UNCLEAR",
                      "REVIEW_FACT_SUPPORT_UNCLEAR"
                    ]
                  }
                },
                "handoff_allowed": {
                  "const": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "REJECTED"
                }
              }
            },
            "then": {
              "properties": {
                "reason_codes": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": [
                      "REJECT_OLD_NEWS",
                      "REJECT_NO_NEW_DEVELOPMENT",
                      "REJECT_NOT_DIRECT_ARTICLE",
                      "REJECT_HOMEPAGE_URL",
                      "REJECT_CATEGORY_URL",
                      "REJECT_SEARCH_URL",
                      "REJECT_TAG_TOPIC_URL",
                      "REJECT_AGGREGATOR_AS_FINAL_SOURCE",
                      "REJECT_REDIRECT_TO_NON_ARTICLE",
                      "REJECT_ARTICLE_INACCESSIBLE",
                      "REJECT_SOURCE_UNVERIFIABLE",
                      "REJECT_HEADLINE_UNSUPPORTED",
                      "REJECT_FACTS_UNSUPPORTED",
                      "REJECT_DUPLICATE_STORY",
                      "REJECT_INVALID_URL"
                    ]
                  }
                },
                "handoff_allowed": {
                  "const": false
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "decisions"
  ],
  "additionalProperties": false
}
