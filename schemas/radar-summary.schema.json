{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fb-news-autopilot:radar-summary:1.0.0",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "shortlisted_count": {
      "type": "integer",
      "minimum": 0
    },
    "preliminary_rejected_count": {
      "type": "integer",
      "minimum": 0
    },
    "shortlisted_news_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "run_id",
    "candidate_count",
    "shortlisted_count",
    "preliminary_rejected_count",
    "shortlisted_news_ids"
  ],
  "additionalProperties": false
}
