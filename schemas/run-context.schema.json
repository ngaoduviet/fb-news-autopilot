{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fb-news-autopilot:run-context:1.0.0",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "run_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "live_window_hours": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "hot_window_hours": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "brand_profile": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "shadow",
        "approval",
        "production"
      ]
    }
  },
  "required": [
    "run_id",
    "run_at",
    "timezone",
    "live_window_hours",
    "hot_window_hours",
    "brand_profile",
    "mode"
  ],
  "additionalProperties": false
}
